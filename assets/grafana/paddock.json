{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "Paddock",
 "uid": "paddock",
 "tags": [
  "shep",
  "paddock",
  "power"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "query": {
     "query": "label_values(paddock_model_loaded, instance)",
     "refId": "instance"
    },
    "definition": "label_values(paddock_model_loaded, instance)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Power",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Wall power",
   "description": "The host's draw at the plug, at the last good read.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_power_watts{meter=\"wall\",instance=~\"$instance\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {},
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Energy in range",
   "description": "Energy the host drew at the plug over the dashboard's time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(paddock_energy_joules_total{meter=\"wall\",instance=~\"$instance\"}[$__range])) / 3600000.0",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {},
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Leases",
   "description": "Granted leases, bare ones included.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(paddock_leases{instance=~\"$instance\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {},
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Waiters",
   "description": "Requests and leases waiting.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(paddock_waiters{instance=~\"$instance\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {},
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Power: wall, parts and the GPU",
   "description": "Wall is the plug, parts the GPU and CPU counters. GPU is what Strata reports for its card while a Strata model is loaded, so the gap to wall is the rest of the host.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_power_watts{instance=~\"$instance\"}",
     "legendFormat": "{{meter}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(paddock_strata_gpu_power_watts{instance=~\"$instance\"})",
     "legendFormat": "GPU (Strata)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Energy per hour",
   "description": "Energy drawn in each hour, from the counter.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (meter) (increase(paddock_energy_joules_total{instance=~\"$instance\"}[1h])) / 3600000.0",
     "legendFormat": "{{meter}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Models and leases",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "state-timeline",
   "title": "Models loaded",
   "description": "Each model while it is loaded.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_model_loaded{instance=~\"$instance\"} == 1",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 70,
      "lineWidth": 0
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Leases by model",
   "description": "Granted leases. A bare lease has no model.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (model) (paddock_leases{instance=~\"$instance\"})",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Waiters by model and reason",
   "description": "Requests and leases waiting, by the reason the status gives.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 21
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (model, reason_kind) (paddock_waiters{instance=~\"$instance\"})",
     "legendFormat": "{{model}} {{reason_kind}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "row",
   "title": "Strata",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 29
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Generation speed and queue",
   "description": "Strata's tokens per second, 0 while it is not generating, and requests queued.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 30
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_strata_tokens_per_second{instance=~\"$instance\"}",
     "legendFormat": "{{model}} tok/s"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_strata_queued{instance=~\"$instance\"}",
     "legendFormat": "{{model}} queued"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Tokens processed",
   "description": "Prompt, reused and output tokens per second, from Strata's counters.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 30
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (model) (rate(paddock_strata_prompt_tokens_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "{{model}} prompt"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (model) (rate(paddock_strata_reused_tokens_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "{{model}} reused"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (model) (rate(paddock_strata_output_tokens_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "{{model}} output"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "GPU utilization and temperature",
   "description": "From Strata's hardware readings while a Strata model is loaded.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 38
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_strata_gpu_utilization_percent{instance=~\"$instance\"}",
     "legendFormat": "{{model}} util %"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_strata_gpu_temperature_celsius{instance=~\"$instance\"}",
     "legendFormat": "{{model}} °C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "GPU memory used",
   "description": "From Strata's hardware readings while a Strata model is loaded.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 38
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "paddock_strata_gpu_memory_used_bytes{instance=~\"$instance\"}",
     "legendFormat": "{{model}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}
